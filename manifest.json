{
  "manifest_version": 3,
  "name": "Canvas to Calendar",
  "version": "1.0.0",
  "key": "",
  "description": "Send your Canvas assignments to Google Calendar, or download them as an .ics file.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Canvas to Calendar",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "options.html",
  "permissions": ["activeTab", "scripting", "storage", "identity"],
  "host_permissions": ["https://www.googleapis.com/*"]
}
